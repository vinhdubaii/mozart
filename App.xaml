<Application x:Class="MozartBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Light is the default merged dictionary here purely so the app has
                     usable colors at design-time / before ThemeService runs. At runtime,
                     App.OnStartup calls ThemeService.Apply(...) immediately after Settings
                     loads, which replaces this entry with Light.xaml or Dark.xaml based on
                     the saved Theme setting (or the Windows theme, for "System"). See
                     Services/ThemeService.cs for how the swap works. -->
                <ResourceDictionary Source="Themes/Light.xaml"/>

                <!-- Implicit (TargetType-only) styles for Button/TextBox/ComboBox/
                     CheckBox/RadioButton, so dark mode covers every standard control
                     in the app automatically — not just the hand-styled toolbar/sidebar
                     elements. This dictionary itself never gets swapped; only the
                     brushes it references (DynamicResource) change with the theme. -->
                <ResourceDictionary Source="Themes/ControlStyles.xaml"/>

                <!-- Every icon in the app (toolbar/window controls, page context menu,
                     hamburger menu, Extensions popup) - Material Symbols, Geometry +
                     DataTemplate resources keyed "Icon.*" - see the top-of-file notes
                     in Icons.xaml itself for the two resource shapes and why. -->
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===================== Shared button style for title bar / toolbar icons =====================
                 Foreground uses DynamicResource (not StaticResource) so buttons re-color
                 immediately when ThemeService swaps the merged dictionary above, without
                 needing the window to be recreated. -->
            <Style x:Key="ChromeIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#14808080"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#22808080"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Close button gets a red hover, like every browser's window controls -->
            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeIconButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Nav cluster (Back/Forward/Reload/Home/New Tab) =====================
                 A slightly bigger touch target than the general ChromeIconButton
                 (which also covers title-bar/library/menu buttons elsewhere, left
                 untouched), paired with real vector icons instead of Unicode glyph
                 characters — those render thin and inconsistently across Windows
                 font fallbacks, which read as "small" even inside a normal-sized
                 button. -->
            <Style x:Key="NavIconButton" TargetType="Button" BasedOn="{StaticResource ChromeIconButton}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
            </Style>

            <!-- Shared look for every nav icon's Path: soft, rounded strokes
                 (Lucide/Feather-style outline icons) rather than filled shapes,
                 matching a softer, more modern feel than the old glyph characters.
                 Each button just supplies its own Data. -->
            <Style x:Key="NavIconPath" TargetType="Path">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Fill" Value="Transparent"/>
                <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
            </Style>

            <!-- Fill-based counterpart to NavIconPath, for the Material Symbols icon
                 set (Themes/Icons.xaml): those are solid filled shapes, not stroke
                 skeletons, so Fill carries the icon and there's no Stroke at all.
                 Used for the toolbar and window-control buttons currently being
                 migrated to Material Symbols. NavIconPath above is left as-is for
                 windows still on the old icon set (Settings, Password Manager,
                 Private window). -->
            <Style x:Key="NavIconPathFilled" TargetType="Path">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Stroke" Value="{x:Null}"/>
            </Style>

            <!-- Same look as NavIconPath, smaller, for icons that sit inline next
                 to text (Settings sidebar items, the settings-window search box,
                 window title icons) rather than alone inside a toolbar button. -->
            <Style x:Key="SidebarIconPath" TargetType="Path">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Fill" Value="Transparent"/>
                <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
            </Style>

            <!-- Sidebar nav item style for the Chromium-style Settings window -->
            <Style x:Key="SettingsSidebarItem" TargetType="RadioButton">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="6,1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#14808080"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
