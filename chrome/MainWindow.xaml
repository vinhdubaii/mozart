<Window x:Class="MozartBrowser.Chrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MozartBrowser.Controls"
        Title="Mozart Browser"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: unified title bar / toolbar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: tab strip (collapsed when 1 tab) -->
            <RowDefinition Height="Auto"/> <!-- Row 2: bookmark bar (toggle) -->
            <RowDefinition Height="*"/>    <!-- Row 3: content host -->
        </Grid.RowDefinitions>

        <!-- ============================= Row 0: Toolbar / custom title bar ============================= -->
        <Grid x:Name="ToolbarRow" Grid.Row="0" Height="44" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- nav buttons -->
                <ColumnDefinition Width="*"/>    <!-- address bar -->
                <ColumnDefinition Width="Auto"/> <!-- library / menu -->
                <ColumnDefinition Width="Auto"/> <!-- min/max/close -->
            </Grid.ColumnDefinitions>

            <!-- Navigation buttons. Icons are real vector Paths (Material Symbols,
                 solid fill — see Icon.Nav.* in Themes/Icons.xaml), not Unicode
                 glyph characters — see NavIconButton's doc comment in App.xaml
                 for why that matters for touch-target/legibility. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource NavIconButton}" Click="BackButton_Click" ToolTip="Back">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.Back}"/>
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource NavIconButton}" Click="ForwardButton_Click" ToolTip="Forward">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.Forward}"/>
                </Button>
                <Button x:Name="ReloadButton" Style="{StaticResource NavIconButton}" Click="ReloadButton_Click" ToolTip="Reload">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.Reload}"/>
                </Button>
                <Button x:Name="HomeButton" Style="{StaticResource NavIconButton}" Click="HomeButton_Click" ToolTip="Home">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.Home}"/>
                </Button>
                <Button x:Name="NewTabButton" Style="{StaticResource NavIconButton}" Click="NewTabButton_Click" ToolTip="New Tab (Ctrl+T)">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.NewTab}"/>
                </Button>
            </StackPanel>

            <!-- Address bar: pill shape, lock + text + star inline. Background is a
                 semi-transparent themed overlay (not a hardcoded color) so a Custom
                 Themes gradient behind the toolbar shows through softly while typed
                 text stays legible in both Light and Dark mode — see
                 Themes/Light.xaml + Dark.xaml's AddressPillOverlayBrush. -->
            <Border Grid.Column="1" Background="{DynamicResource AddressPillOverlayBrush}" CornerRadius="16" MinHeight="32"
                    Margin="60,0,60,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Visibility (not the icon itself) toggles with the page's
                         HTTPS status in code-behind, replacing the old emoji's
                         "swap to empty text" approach. -->
                    <Path x:Name="LockIcon" Grid.Column="0"
                          Width="13" Height="13" Stretch="Uniform" Margin="12,0,4,0" VerticalAlignment="Center"
                          Fill="{DynamicResource TextSecondaryBrush}" Stroke="{x:Null}"
                          Data="{StaticResource Icon.Nav.Lock}"/>

                    <TextBox x:Name="AddressBarTextBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                             KeyDown="AddressBarTextBox_KeyDown"
                             GotFocus="AddressBarTextBox_GotFocus"/>

                    <!-- Fill toggles between TextPrimaryBrush (not bookmarked) and the
                         accent brush (bookmarked) in code-behind. Material Symbols'
                         "bookmark" glyph is a single solid ribbon shape (its own path
                         already reads as an outline via its inner cutout), so a color
                         swap is enough — no separate filled variant needed. -->
                    <Button x:Name="BookmarkStarButton" Grid.Column="2" Style="{StaticResource ChromeIconButton}"
                            Width="28" Height="28" Margin="0,0,2,0" Click="BookmarkStarButton_Click"
                            ToolTip="Bookmark this page">
                        <Path x:Name="BookmarkStarPath" Width="15" Height="15" Stretch="Uniform"
                              Fill="{DynamicResource TextPrimaryBrush}" Stroke="{x:Null}"
                              Data="{StaticResource Icon.Nav.Bookmark}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Pinned extensions + puzzle icon + Library + menu -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                <!-- Populated at runtime by RebuildPinnedExtensionIcons(), one
                     NavIconButton per pinned extension, in pin order. -->
                <StackPanel x:Name="PinnedExtensionsPanel" Orientation="Horizontal"/>

                <Button x:Name="ExtensionsButton" Style="{StaticResource NavIconButton}" Click="ExtensionsButton_Click"
                        ToolTip="Extensions">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.Extensions}"/>
                </Button>
                <Button x:Name="LibraryButton" Style="{StaticResource NavIconButton}" Click="LibraryButton_Click"
                        ToolTip="Bookmarks, History &amp; Downloads">
                    <Path Style="{StaticResource NavIconPath}"
                          Data="M19.5617,7C19.7904,5.69523 18.7863,4.5 17.4617,4.5H6.53788C5.21323,4.5 4.20922,5.69523 4.43784,7 M17.4999,4.5C17.5283,4.24092 17.5425,4.11135 17.5427,4.00435C17.545,2.98072 16.7739,2.12064 15.7561,2.01142C15.6497,2 15.5194,2 15.2588,2H8.74099C8.48035,2 8.35002,2 8.24362,2.01142C7.22584,2.12064 6.45481,2.98072 6.45704,4.00434C6.45727,4.11135 6.47146,4.2409 6.49983,4.5 M15,18H9 M21.1935,16.793C20.8437,19.2739 20.6689,20.5143 19.7717,21.2572C18.8745,22 17.5512,22 14.9046,22H9.09536C6.44881,22 5.12553,22 4.22834,21.2572C3.33115,20.5143 3.15626,19.2739 2.80648,16.793L2.38351,13.793C1.93748,10.6294 1.71447,9.04765 2.66232,8.02383C3.61017,7 5.29758,7 8.67239,7H15.3276C18.7024,7 20.3898,7 21.3377,8.02383C22.0865,8.83268 22.1045,9.98979 21.8592,12"/>
                </Button>
                <Button x:Name="MenuButton" Style="{StaticResource NavIconButton}" Click="MenuButton_Click" ToolTip="Menu">
                    <Path Style="{StaticResource NavIconPathFilled}" Data="{StaticResource Icon.Nav.Menu}"/>
                </Button>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,4,0">
                <Button Style="{StaticResource ChromeIconButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                    <Path Style="{StaticResource NavIconPathFilled}" Width="14" Height="14" Data="{StaticResource Icon.Nav.Minimize}"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeIconButton}" Click="MaximizeButton_Click" ToolTip="Maximize">
                    <Path x:Name="MaximizeIconPath" Style="{StaticResource NavIconPathFilled}" Width="14" Height="14" Data="{StaticResource Icon.Nav.Maximize}"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="Close">
                    <Path Style="{StaticResource NavIconPathFilled}" Width="14" Height="14" Data="{StaticResource Icon.Nav.Close}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================= Row 1: Tab strip (visible only when >= 2 tabs) ============================= -->
        <Border x:Name="TabStripBorder" Grid.Row="1" Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="TabStripItems" Height="34">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ============================= Row 2: Bookmark bar (toggle via menu) ============================= -->
        <Border x:Name="BookmarkBarHost" Grid.Row="2" Height="30"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <ItemsControl x:Name="BookmarkBarItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ============================= Row 3: Content host + slide-out Library panel ============================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Each BrowserTab's WebView2 (or NewTabPage) is added here in code-behind,
                 with only the active tab's element set to Visible. -->
            <Grid x:Name="TabContentHost" Grid.Column="0"/>

            <controls:LibraryPanel x:Name="LibraryPanelControl" Grid.Column="1"
                                 Width="340" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
