<UserControl x:Class="MozartBrowser.Controls.DownloadsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Popup x:Name="FlyoutPopup" StaysOpen="False" AllowsTransparency="True"
           Placement="Bottom" PopupAnimation="Fade"
           Closed="FlyoutPopup_Closed">
        <Border Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                CornerRadius="8" Width="340" MaxHeight="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recent download history" FontWeight="Bold" FontSize="14"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="1" Content="&#x2715;" Width="26" Height="26"
                            Style="{StaticResource ChromeIconButton}" Click="CloseButton_Click"
                            ToolTip="Close"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <StackPanel x:Name="RowsPanel" Margin="6,4"/>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="FullHistoryButton" Click="FullHistoryButton_Click"
                            Style="{StaticResource ChromeIconButton}"
                            HorizontalContentAlignment="Left" Padding="14,10" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Full download history" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Path Grid.Column="1" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="M280-200v-80h360L120-800l56-56 520 520v-360h80v480H280Z"/>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Popup>
</UserControl>
