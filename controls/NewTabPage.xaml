<UserControl x:Class="MozartBrowser.Controls.NewTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrushHolder" Color="Transparent"/>
        </Grid.Background>

        <!-- Semi-transparent overlay so top sites stay legible over bright custom backgrounds -->
        <Border x:Name="OverlayBorder" Background="#000000" Opacity="0" IsHitTestVisible="False"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="960">

            <TextBlock Text="Mozart Browser" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,28"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel x:Name="PinnedSection" Margin="0,0,0,20">
                <TextBlock Text="Pinned" FontSize="13" FontWeight="SemiBold"
                           Margin="4,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ItemsControl x:Name="PinnedGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="RecentSection">
                <TextBlock Text="Recently visited" FontSize="13" FontWeight="SemiBold"
                           Margin="4,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ItemsControl x:Name="RecentGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="EmptyStateText"
                       Text="Your top sites will appear here as you browse."
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Button x:Name="CustomizeButton" Content="🎨 Customize"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="10,6"
                Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0" Cursor="Hand"
                Click="CustomizeButton_Click"/>
    </Grid>
</UserControl>
