<Window x:Class="MozartBrowser.Dialogs.AddPinnedSiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Pinned Site" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Add Pinned Site" FontSize="12" Margin="14,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Width="36" Height="36"
                    Click="CancelButton_Click" Content="✕" ToolTip="Close"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Name" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

            <TextBlock Text="Address" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="UrlBox" Text="https://"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Padding="12,4" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Add" Padding="12,4" Click="AddButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
