<Window x:Class="MozartBrowser.Dialogs.BackgroundPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Background" Height="280" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar — no minimize/maximize since this dialog is fixed-size (ResizeMode=NoResize),
             just drag-to-move and Close, matching MainWindow's visual language. -->
        <Grid Grid.Row="0" Height="36" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Customize Background" FontSize="12" Margin="14,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Width="36" Height="36"
                    Click="CancelButton_Click" Content="✕" ToolTip="Close"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20">
        <TextBlock Text="New Tab Background" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

        <RadioButton x:Name="NoneOption" Content="None (default theme)" GroupName="BgType" Margin="0,4"/>
        <RadioButton x:Name="ColorOption" Content="Solid color" GroupName="BgType" Margin="0,4"/>

        <StackPanel Orientation="Horizontal" Margin="20,0,0,8" x:Name="ColorRow">
            <TextBlock Text="Hex:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ColorHexBox" Width="120" Text="#1A1A2E"/>
        </StackPanel>

        <RadioButton x:Name="CustomOption" Content="Custom image..." GroupName="BgType" Margin="0,4"/>
        <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
            <Button x:Name="BrowseButton" Content="Choose file..." Padding="8,4" Click="BrowseButton_Click"/>
            <TextBlock x:Name="SelectedFileText" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="12,4" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Apply" Padding="12,4" Click="ApplyButton_Click"/>
        </StackPanel>
        </StackPanel>
    </Grid>
</Window>
