<Window x:Class="MozartBrowser.Dialogs.DeleteBrowsingDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete browsing data" Height="460" Width="440" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Height="40" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="🗑" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Delete browsing data" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Width="40" Height="40"
                    Click="CancelButton_Click" Content="✕" ToolTip="Close"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,8,24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Time range" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="TimeRangeCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16"
                          SelectedIndex="2">
                    <ComboBoxItem Content="Last hour"/>
                    <ComboBoxItem Content="Last 24 hours"/>
                    <ComboBoxItem Content="Last 7 days"/>
                    <ComboBoxItem Content="Last 4 weeks"/>
                    <ComboBoxItem Content="All time"/>
                </ComboBox>

                <CheckBox x:Name="HistoryCheck" Content="Browsing history" Margin="0,4" IsChecked="True"/>
                <CheckBox x:Name="CookiesCheck" Content="Cookies and other site data" Margin="0,4" IsChecked="True"/>
                <CheckBox x:Name="CacheCheck" Content="Cached images and files" Margin="0,4" IsChecked="True"/>
                <CheckBox x:Name="DownloadHistoryCheck" Content="Download history" Margin="0,4"/>
                <CheckBox x:Name="AutofillCheck" Content="Autofill form data" Margin="0,4"/>
                <CheckBox x:Name="PasswordsCheck" Content="Passwords" Margin="0,4"/>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource ChromeBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
                <Button Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="DeleteButton" Content="Delete data" Padding="14,5" Click="DeleteButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
