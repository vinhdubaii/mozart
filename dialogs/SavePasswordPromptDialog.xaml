<Window x:Class="MozartBrowser.Dialogs.SavePasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save password?" Width="320" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PromptTextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="10" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SurfaceAltBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderText" Grid.Column="0" Text="Save password?" FontSize="13" FontWeight="SemiBold"
                           Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Button Grid.Column="1" Style="{StaticResource CloseButton}" Width="36" Height="36"
                        Click="NeverButton_Click" Content="✕" ToolTip="Dismiss"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="16,0,16,16">
                <TextBlock x:Name="DomainText" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                <TextBlock x:Name="UsernameText" FontSize="12" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="PasswordText" FontSize="12" Text="••••••••"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="RevealButton" Grid.Column="1" Content="Show" FontSize="11" Padding="8,3"
                            VerticalAlignment="Bottom" Click="RevealButton_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Never" Style="{StaticResource PromptTextButton}" Margin="0,0,8,0" Click="NeverButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PromptTextButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
