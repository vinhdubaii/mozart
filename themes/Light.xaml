<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Epiphany / GNOME-ish neutral light palette -->
    <Color x:Key="ChromeBackgroundColor">#F0F0F2</Color>
    <Color x:Key="ChromeBorderColor">#D8D8DC</Color>
    <Color x:Key="TabActiveColor">#FFFFFF</Color>
    <Color x:Key="TabInactiveColor">#00000000</Color>
    <Color x:Key="AccentColor">#3584E4</Color>
    <Color x:Key="TextPrimaryColor">#1B1B1F</Color>
    <Color x:Key="TextSecondaryColor">#6E6E73</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#E7E7EA</Color>
    <Color x:Key="SidebarSelectedColor">#DCE9FB</Color>

    <!-- Address bar pill background: semi-transparent so a Custom Themes
         gradient behind the toolbar shows through softly, while staying
         light enough that dark text on top of it always stays legible
         regardless of what color is behind it. -->
    <Color x:Key="AddressPillOverlayColor">#CCFFFFFF</Color>

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{StaticResource ChromeBackgroundColor}"/>
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="{StaticResource ChromeBorderColor}"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource TabActiveColor}"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="{StaticResource TabInactiveColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}"/>
    <SolidColorBrush x:Key="AddressPillOverlayBrush" Color="{StaticResource AddressPillOverlayColor}"/>

</ResourceDictionary>
