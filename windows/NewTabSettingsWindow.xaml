<Window x:Class="MozartBrowser.Windows.NewTabSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize New Tab Page" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar — matches MainWindow's visual language. -->
        <Grid Grid.Row="0" Height="36" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Customize New Tab Page" FontSize="12" Margin="14,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Width="36" Height="36"
                    Click="CancelButton_Click" Content="✕" ToolTip="Close"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- ===================== Layout ===================== -->
                <TextBlock Text="Layout" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                <CheckBox x:Name="ShowPinnedCheck" Content="Show pinned sites" Margin="0,4"/>
                <CheckBox x:Name="ShowRecentCheck" Content="Show recently visited" Margin="0,4,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Columns:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ColumnsCombo" Width="80"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,20"/>

                <!-- ===================== Background ===================== -->
                <TextBlock Text="New Tab Background" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                <RadioButton x:Name="NoneOption" Content="None (default theme)" GroupName="BgType" Margin="0,4"/>
                <RadioButton x:Name="ColorOption" Content="Solid color" GroupName="BgType" Margin="0,4"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,8" x:Name="ColorRow">
                    <TextBlock Text="Hex:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ColorHexBox" Width="120" Text="#1A1A2E"/>
                </StackPanel>

                <RadioButton x:Name="CustomOption" Content="Custom image..." GroupName="BgType" Margin="0,4"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                    <Button x:Name="BrowseButton" Content="Choose file..." Padding="8,4" Click="BrowseButton_Click"/>
                    <TextBlock x:Name="SelectedFileText" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="Cancel" Padding="12,4" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Apply" Padding="12,4" Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
